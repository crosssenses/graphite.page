  <div class="btn-group" role="group" aria-label="Share">
    <span class="input-group-addon" id="btnGroupAddon">Share</span>
    
      <a href="https://www.linkedin.com/shareArticle?mini=true&url=https%3A//graphite.page/doa-blueprintassets/images/figures/Prozess_EN.png&summary=The+Interaction+of+Stakeholder+Groups+and+Central+Topics+%3Cbr%3E%3Cbr%3E+%3Ci%3ENote%3C%2Fi%3E%3A+For+better+readability+use+the+%3Ca+href%3D%27%27+data-toggle%3D%27modal%27+data-target%3D%27%2312Modal%27%3Efull+screen+mode%3C%2Fa%3E.&title=Collaborative+Diamond+Open+Access+Publishing+as+a+Process"
         target="_blank" class="btn btn-secondary" rel="noopener noreferrer">
        <i class="mdi mdi-linkedin"></i>
